<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:YgoMDStartingHandRecorder.Controls"
             xmlns:vm="clr-namespace:YgoMDStartingHandRecorder.ViewModels"
             x:Class="YgoMDStartingHandRecorder.Views.CardPickOverlay"
             x:DataType="vm:CardPickViewModel">
  <UserControl.Styles>
    <Style Selector="ListBox.md ListBoxItem:selected">
      <Setter Property="Background" Value="#24E6C15C" />
      <Setter Property="BorderBrush" Value="#73E6C15C" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </UserControl.Styles>
  <Grid Background="#B804060A">
    <ctl:CutBorder Cut="14" Width="560" MaxHeight="860"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   BorderBrush="{StaticResource LineHiBrush}" BorderThickness="1">
      <ctl:CutBorder.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="#171D2C" />
          <GradientStop Offset="1" Color="#10141F" />
        </LinearGradientBrush>
      </ctl:CutBorder.Background>
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="44" Background="{StaticResource HeadSteel}"
                BorderBrush="{StaticResource SteelEdgeBrush}" BorderThickness="0,0,0,1"
                BoxShadow="inset 0 1 0 0 #99FFFFFF" Padding="16,0">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" FontWeight="Bold" FontSize="15" Foreground="{StaticResource SteelInkBrush}"
                       VerticalAlignment="Center">
              <Run Text="选择卡名 · 槽 " /><Run Text="{Binding SlotIndex}" />
            </TextBlock>
            <TextBlock Grid.Column="1" Foreground="{StaticResource SteelInkDimBrush}" FontSize="11" FontFamily="{StaticResource NumFont}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
              <Run Text="raw = " /><Run Text="{Binding Raw}" />
            </TextBlock>
          </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="16,12" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0" Background="#990A0D14">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1" Classes="md md-ghost" Content="取消" Margin="0,0,10,0"
                    Command="{Binding CancelCommand}" />
            <Button Grid.Column="2" Classes="md md-steel" Content="确定" Command="{Binding ConfirmCommand}" />
          </Grid>
        </Border>
        <StackPanel Margin="16,16" Spacing="14">
          <!-- 搜索 -->
          <Grid>
            <TextBox Classes="md" Height="38" Padding="34,0,12,0" VerticalContentAlignment="Center"
                     Text="{Binding Query, Mode=TwoWay}" PlaceholderText="输入卡名搜索全卡表…" />
            <Path Data="M11,4 a7,7 0 1,0 0.001,0 M16,16 L21,21" Stroke="{StaticResource DimBrush}" StrokeThickness="1.6"
                  Width="15" Height="15" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                  IsHitTestVisible="False" />
          </Grid>
          <TextBlock Text="弱匹配候选 top-5（按相似度）· 输入即搜全卡表" Foreground="{StaticResource DimBrush}" FontSize="11" />
          <!-- 候选 -->
          <ListBox x:Name="CandList" Classes="md" MaxHeight="380" AutomationProperties.Name="候选列表"
                   ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                   DoubleTapped="OnDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PickItemViewModel">
                <ctl:CutBorder Cut="7" Background="{StaticResource SlotBg}"
                               BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="10,8">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Grid Grid.Column="0" Width="40" Height="58" Margin="0,0,11,0">
                      <Image Source="{Binding Thumb}" Stretch="UniformToFill" IsVisible="{Binding HasThumb}" />
                      <Grid IsVisible="{Binding !HasThumb}">
                        <Rectangle Fill="{x:Static ctl:MdBrushes.StripeTile}"
                                   Stroke="{StaticResource LineHiBrush}" StrokeThickness="1" StrokeDashArray="3,2" />
                        <Path Data="{StaticResource ImgOffGeo}" Stroke="{StaticResource DimBrush}"
                              StrokeThickness="1.6" Stretch="Uniform" Width="20" Height="20"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Grid>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13.5" Foreground="White"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Sub}" Foreground="{StaticResource DimBrush}" FontSize="10.5"
                                 FontFamily="{StaticResource NumFont}" />
                    </StackPanel>
                    <ctl:CutBorder Grid.Column="2" Slant="True" Cut="4" Height="20" Padding="8,0" Margin="0,0,10,0"
                                   Background="{Binding SimBg}" BorderBrush="{Binding SimBorder}" BorderThickness="1"
                                   IsVisible="{Binding ShowSim}" VerticalAlignment="Center">
                      <TextBlock Text="{Binding SimText}" Foreground="{Binding SimFg}" FontSize="11" FontWeight="Bold"
                                 FontFamily="{StaticResource NumFont}" VerticalAlignment="Center" />
                    </ctl:CutBorder>
                    <Grid Grid.Column="3" Width="16" Height="16" VerticalAlignment="Center">
                      <Ellipse Stroke="{StaticResource LineHiBrush}" StrokeThickness="1.5" />
                      <Ellipse Margin="4" Fill="{StaticResource GoldBrush}"
                               IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
                    </Grid>
                  </Grid>
                </ctl:CutBorder>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Data="M12,2 L14.4,9.2 L22,9.2 L16,13.8 L18.3,21 L12,16.5 L5.7,21 L8,13.8 L2,9.2 L9.6,9.2 Z"
                  Fill="{StaticResource GoldBrush}" Width="13" Height="13" VerticalAlignment="Center" />
            <TextBlock Text="确定后写入 OcrAlias：下次同段坏 OCR 自动命中（sim=1.00）"
                       Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </ctl:CutBorder>
  </Grid>
</UserControl>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:YgoMDStartingHandRecorder.Controls"
             xmlns:vm="clr-namespace:YgoMDStartingHandRecorder.ViewModels"
             x:Class="YgoMDStartingHandRecorder.Views.StorageView"
             x:DataType="vm:StorageViewModel">
  <ScrollViewer>
    <StackPanel Margin="14,16" Spacing="14">
      <Border IsVisible="{Binding MissingCards}" Background="#24E6C15C" BorderBrush="#73E6C15C"
              BorderThickness="1" Padding="12,10">
        <StackPanel Spacing="4">
          <TextBlock Text="缺少卡片数据" Foreground="{StaticResource GoldBrush}" FontSize="13" FontWeight="Bold" />
          <TextBlock Text="程序不再自带卡表。点「更新卡表」从百鸽数据源下载（zip 约 2.4MB，解包后约 13.9MB）；下载完成前捕获识别不可用，记录/卡组页仍可浏览。"
                     Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <ctl:CutBorder Cut="10" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Height="36" Background="{StaticResource HeadSteel}"
                  BorderBrush="{StaticResource SteelEdgeBrush}" BorderThickness="0,0,0,1"
                  BoxShadow="inset 0 1 0 0 #99FFFFFF">
            <TextBlock Text="卡片数据（卡表 + 卡图缓存）" Margin="12,0" FontWeight="Bold" FontSize="13"
                       Foreground="{StaticResource SteelInkBrush}" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Row="1" Margin="12,12" Spacing="8">
            <Grid ColumnDefinitions="70,*,Auto,Auto,Auto">
              <TextBlock Text="目录" Foreground="{StaticResource DimBrush}" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding CardDir}" Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <Button Grid.Column="2" Classes="md md-ghost md-sm" Content="更改路径" Margin="10,0,0,0"
                      Command="{Binding ChangeCardDirCommand}" />
              <Button Grid.Column="3" Classes="md md-dghost md-sm" Content="{Binding CleanCardLabel}" Margin="8,0,0,0"
                      Command="{Binding CleanCardImgCommand}" />
              <Button Grid.Column="4" Classes="md md-steel md-sm" Content="更新卡表" Margin="8,0,0,0"
                      Command="{Binding UpdateCommand}" />
            </Grid>
            <Grid ColumnDefinitions="70,*,70,*">
              <TextBlock Text="占用" Foreground="{StaticResource DimBrush}" FontSize="11" />
              <TextBlock Grid.Column="1" Text="{Binding CardSize}" Foreground="#CFD6E4" FontSize="12" FontFamily="{StaticResource NumFont}" />
              <TextBlock Grid.Column="2" Text="卡表" Foreground="{StaticResource DimBrush}" FontSize="11" />
              <TextBlock Grid.Column="3" Text="{Binding CardCount}" Foreground="#CFD6E4" FontSize="12" FontFamily="{StaticResource NumFont}" />
            </Grid>
            <Grid ColumnDefinitions="70,*,70,*">
              <TextBlock Text="更新时间" Foreground="{StaticResource DimBrush}" FontSize="11" />
              <TextBlock Grid.Column="1" Text="{Binding CardUpdated}" Foreground="#CFD6E4" FontSize="12" FontFamily="{StaticResource NumFont}" />
              <TextBlock Grid.Column="2" Text="MD5" Foreground="{StaticResource DimBrush}" FontSize="11" />
              <TextBlock Grid.Column="3" Text="{Binding CardMd5}" Foreground="#CFD6E4" FontSize="11"
                         FontFamily="{StaticResource NumFont}" TextTrimming="CharacterEllipsis" />
            </Grid>
            <TextBlock Text="默认在系统文档 Documents\YgoHand\carddata（repo 开发回退 repo/data）。卡图按需从 CDN 下载缩略图到本目录 cardimg/，与卡表一起统计占用、改路径时一起搬迁;「清理卡图缓存」只删 cardimg、保留卡表。数据源：ygocdb.com/api/v0（cards.zip + 官方 MD5 校验）。"
                       Foreground="{StaticResource DimBrush}" FontSize="10.5" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </ctl:CutBorder>

      <ctl:CutBorder Cut="10" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Height="36" Background="{StaticResource HeadSteel}"
                  BorderBrush="{StaticResource SteelEdgeBrush}" BorderThickness="0,0,0,1"
                  BoxShadow="inset 0 1 0 0 #99FFFFFF">
            <TextBlock Text="起手截图" Margin="12,0" FontWeight="Bold" FontSize="13"
                       Foreground="{StaticResource SteelInkBrush}" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Row="1" Margin="12,12" Spacing="8">
            <Grid ColumnDefinitions="70,*,Auto,Auto">
              <TextBlock Text="目录" Foreground="{StaticResource DimBrush}" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding CapturesDir}" Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <Button Grid.Column="2" Classes="md md-ghost md-sm" Content="更改路径" Margin="10,0,0,0"
                      Command="{Binding ChangeCapturesDirCommand}" />
              <Button Grid.Column="3" Classes="md md-dghost md-sm" Content="{Binding CleanShotsLabel}" Margin="8,0,0,0"
                      Command="{Binding CleanShotsCommand}" />
            </Grid>
            <Grid ColumnDefinitions="70,*">
              <TextBlock Text="占用" Foreground="{StaticResource DimBrush}" FontSize="11" />
              <TextBlock Grid.Column="1" Text="{Binding CapturesSize}" Foreground="#CFD6E4" FontSize="12" FontFamily="{StaticResource NumFont}" />
            </Grid>
            <TextBlock Text="默认在系统文档 Documents\YgoHand\captures。捕获页每次截图自动存 PNG 到此目录;「清理截图」清空目录并把记录标记为「证据截图已被清理」（与记录页同语义）。改路径会把现有截图一起搬迁。"
                       Foreground="{StaticResource DimBrush}" FontSize="10.5" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </ctl:CutBorder>

      <ctl:CutBorder Cut="10" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <StackPanel Margin="12,12" Spacing="6">
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="6"
                       Foreground="{StaticResource GoldBrush}" Background="#161C2B" />
          <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                     FontFamily="{StaticResource NumFont}" />
        </StackPanel>
      </ctl:CutBorder>
    </StackPanel>
  </ScrollViewer>
</UserControl>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:YgoMDStartingHandRecorder.Controls"
             xmlns:vm="clr-namespace:YgoMDStartingHandRecorder.ViewModels"
             x:Class="YgoMDStartingHandRecorder.Views.AliasOverlay"
             x:DataType="vm:AliasViewModel">
  <Grid Background="#B804060A">
    <ctl:CutBorder Cut="14" Width="680" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineHiBrush}"
                   BorderThickness="1" BoxShadow="0 12 40 0 #99000000">
      <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Height="40" Background="{StaticResource HeadSteel}"
                BorderBrush="{StaticResource SteelEdgeBrush}" BorderThickness="0,0,0,1"
                BoxShadow="inset 0 1 0 0 #99FFFFFF">
          <Grid ColumnDefinitions="*,Auto" Margin="16,0">
            <TextBlock Text="错误识别映射" Foreground="{StaticResource SteelInkBrush}" FontWeight="Bold" FontSize="14"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="人工确认的 OCR 原文→卡" Foreground="{StaticResource SteelInkDimBrush}"
                       FontSize="11" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <ListBox Grid.Row="1" Classes="md" Margin="10" MaxHeight="460" AutomationProperties.Name="映射列表"
                 ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AliasItemViewModel">
              <TextBlock Text="{Binding Display}" FontSize="12.5" Foreground="{StaticResource TextBrush}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="14,0,14,14">
          <Button Classes="md md-dghost md-sm" Content="删除选中" Command="{Binding DeleteCommand}" />
          <Button Classes="md md-ghost md-sm" Content="关闭" Command="{Binding CloseCommand}" />
        </StackPanel>
      </Grid>
    </ctl:CutBorder>
  </Grid>
</UserControl>